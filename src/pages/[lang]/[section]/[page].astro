---
import SolutionPage from '@components/SolutionPage.astro';
import CaseStudyPage from '@components/pages/CaseStudyPage.astro';
import DocsArticlePage from '@components/pages/DocsArticlePage.astro';

import { solutions, solutionIds, solutionLabels } from '@/data/copy';
import { caseStudies } from '@/data/cases';
import { docArticles, findArticle } from '@/data/docs';
import { LANGUAGES, routes, type Lang, type RouteId } from '@i18n/routes';

/**
 * Paginas de dois segmentos.
 *
 * Tres familias partilham esta forma de URL: as paginas de solucao
 * (/pt/plataforma/b2c/), os casos de sucesso (/pt/casos-de-sucesso/<slug>/) e
 * os artigos da documentacao (/pt/documentacao/<slug>/). Tem de partilhar
 * este ficheiro porque o Astro so admite uma rota dinamica por profundidade —
 * dai o despacho no fim.
 */

export function getStaticPaths() {
  const paths = [];

  for (const lang of LANGUAGES) {
    for (const id of solutionIds) {
      const slug = routes[id][lang];
      const parts = slug.split('/');
      if (parts.length !== 2) continue;

      paths.push({
        params: { lang, section: parts[0], page: parts[1] },
        props: { kind: 'solution', routeId: id },
      });
    }

    for (const study of caseStudies) {
      paths.push({
        params: { lang, section: routes.cases[lang], page: study.slug },
        props: { kind: 'case', slug: study.slug },
      });
    }

    // O manual so existe em portugues. Gerar os mesmos 71 artigos sob /en/
    // criaria conteudo duplicado sem acrescentar nada: o indice em ingles
    // avisa e liga diretamente aos artigos portugueses.
    if (lang === 'pt') {
      for (const article of docArticles) {
        paths.push({
          params: { lang, section: routes.docs[lang], page: article.slug },
          props: { kind: 'doc', slug: article.slug },
        });
      }
    }
  }

  return paths;
}

const lang = Astro.params.lang as Lang;
const props = Astro.props as
  | { kind: 'solution'; routeId: RouteId }
  | { kind: 'case'; slug: string }
  | { kind: 'doc'; slug: string };

const study = props.kind === 'case' ? caseStudies.find((item) => item.slug === props.slug) : undefined;
const article = props.kind === 'doc' ? findArticle(props.slug) : undefined;

// Nas paginas de solucao, o primeiro segmento corresponde sempre a pagina-mae.
const parentRoute: RouteId =
  props.kind !== 'solution'
    ? 'platform'
    : props.routeId.startsWith('fashion')
      ? 'fashion'
      : props.routeId.startsWith('service')
        ? 'services'
        : 'platform';

const parentLabels: Record<'platform' | 'services' | 'fashion', Record<Lang, string>> = {
  platform: { pt: 'Plataforma', en: 'Platform' },
  services: { pt: 'Serviços', en: 'Services' },
  fashion: { pt: 'Fashion Retail', en: 'Fashion Retail' },
};
const parentLabel = parentLabels[parentRoute as 'platform' | 'services' | 'fashion'][lang];
---

{
  props.kind === 'solution' && (
    <SolutionPage
      lang={lang}
      routeId={props.routeId}
      copy={solutions[props.routeId]![lang]}
      parent={{ label: parentLabel, route: parentRoute }}
      relatedLabels={solutionLabels(lang)}
    />
  )
}

{study && <CaseStudyPage lang={lang} study={study} />}
{article && <DocsArticlePage lang={lang} article={article} />}
