---
import Logo from '@components/Logo.astro';
import SocialLinks from '@components/SocialLinks.astro';
import NewsletterForm from '@components/NewsletterForm.astro';
import { footerSections, footerCompany, resolveLink } from '@/data/navigation';
import { site, currentYear } from '@/data/site';
import { path, type Lang } from '@i18n/routes';
import { useTranslations } from '@i18n/utils';

/**
 * Rodape.
 *
 * Deixou de ser um segundo mapa do site. As tres seccoes sao so tres
 * destinos, porque a lista de subpaginas ja esta no menu e outra vez dentro
 * de cada pagina-mae. Os escritorios sairam daqui: estao na pagina de
 * Contactos e no Sobre Nos, que e onde alguem os procura.
 *
 * A ordem do lado direito e Redicom primeiro e as tres seccoes depois: quem
 * chega ao rodape ja passou pelas seccoes na barra de navegacao, e o que
 * costuma procurar aqui e a empresa.
 *
 * O apoio ao cliente fica: e a unica informacao do rodape que resolve um
 * problema em vez de levar a outra pagina.
 */

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

/**
 * Livro de Reclamacoes eletronico. O DL 156/2005, na redaccao dada pelo
 * DL 74/2017, obriga os prestadores de servicos com sitio na internet a
 * disponibilizarem aqui a ligacao para a plataforma oficial.
 */
const COMPLAINTS_URL = 'https://www.livroreclamacoes.pt/inicio';
---

<footer class="footer on-dark">
  <div class="container">
    <!-- As redes ficam em cima, antes de tudo o resto: e o unico bloco do
         rodape que leva para fora do site. -->
    <div class="footer__social-row">
      <p class="footer__social-label">{t('footer.social')}</p>
      <SocialLinks />
    </div>

    <div class="footer__top">
      <div class="footer__brand">
        <Logo lang={lang} tone="light" height={38} />
        <p class="footer__pitch">{t('site.tagline')}</p>

        <div class="footer__support">
          <p class="footer__support-title">{t('footer.support')}</p>
          <p class="footer__support-hours">{t('footer.supportHours')}</p>
          <p>
            <a href={`tel:${site.support.phone}`}>{site.support.phoneDisplay}</a>
            <span class="footer__note">{t('footer.landline')}</span>
          </p>
          <p>
            <a href={`mailto:${site.email.support}`}>{site.email.support}</a>
          </p>
        </div>
      </div>

      <div class="footer__right">
        <nav class="footer__company" aria-label={footerCompany.title[lang]}>
          <h2 class="footer__group-title">{footerCompany.title[lang]}</h2>
          <ul class="footer__list">
            {
              footerCompany.links.map((link) => {
                const resolved = resolveLink(link, lang);
                return (
                  <li>
                    <a href={resolved.href}>{resolved.label}</a>
                  </li>
                );
              })
            }
          </ul>
        </nav>

        <nav class="footer__sections" aria-label={t('nav.main')}>
          {
            footerSections.map((group) => (
              <a class="footer__section" href={path(group.route!, lang)}>
                <span>{group.title[lang]}</span>
                <span class="footer__section-arrow" aria-hidden="true">
                  →
                </span>
              </a>
            ))
          }
        </nav>

        <div class="footer__news">
          <h2 class="footer__group-title">{t('news.title')}</h2>
          <p class="footer__news-body">{t('news.body')}</p>
          <NewsletterForm lang={lang} id="newsletter-footer" />
        </div>
      </div>
    </div>

    <div class="footer__bottom">
      <p class="footer__copy">
        &copy; {site.foundingYear}-{currentYear} {site.legalName}. {t('footer.rights')}
      </p>

      <a
        class="footer__complaints"
        href={COMPLAINTS_URL}
        target="_blank"
        rel="noopener noreferrer"
        title={t('footer.complaintsNote')}
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 4.5A1.5 1.5 0 0 1 5.5 3H19v16H5.5A1.5 1.5 0 0 0 4 20.5z" />
          <path d="M4 20.5A1.5 1.5 0 0 1 5.5 19H19v2H5.5A1.5 1.5 0 0 1 4 20.5z" />
          <path d="M8 8h7M8 11.5h7" />
        </svg>
        {t('footer.complaints')}
      </a>

      <a class="footer__privacy" href={path('privacy', lang)}>
        {lang === 'pt' ? 'Política de Privacidade' : 'Privacy Policy'}
      </a>
    </div>
  </div>
</footer>

<style>
  /* Sem margem em cima: a banda de conversao que vem antes passou a clara, e
     uma folga entre as duas deixava uma risca da cor do fundo da pagina. */
  .footer {
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .footer :global(a) {
    color: var(--text-on-inverse-muted);
    text-decoration: none;
  }

  .footer :global(a:hover) {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .footer__social-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-lg);
    padding-block-end: var(--space-lg);
    margin-block-end: var(--space-xl);
    border-block-end: 1px solid var(--border-inverse);
  }

  .footer__social-label {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand-orange-bright);
  }

  .footer__top {
    display: grid;
    gap: var(--space-2xl);
  }

  @media (min-width: 62rem) {
    .footer__top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
      gap: var(--space-3xl);
    }
  }

  .footer__pitch {
    margin-block-start: var(--space-md);
    max-width: 30ch;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    color: #fff;
  }

  .footer__support {
    margin-block-start: var(--space-lg);
    font-size: var(--step--1);
    line-height: 1.7;
  }

  .footer__support-title {
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    color: #fff;
  }

  .footer__support-hours {
    color: var(--text-muted);
  }

  .footer__note {
    display: block;
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .footer__right {
    display: grid;
    gap: var(--space-xl);
    align-content: start;
  }

  /* Tres destinos, nao tres listas. Sao grandes de proposito: e para onde
     se vai, nao um titulo de coluna. */
  .footer__sections {
    display: grid;
    gap: var(--space-sm);
  }

  @media (min-width: 40rem) {
    .footer__sections {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .footer__section {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: 0.85rem 1rem;
    border: 1px solid var(--border-inverse);
    border-radius: var(--radius-md);
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: var(--weight-semibold);
  }

  .footer :global(a.footer__section) {
    color: #fff;
  }

  .footer :global(a.footer__section:hover) {
    color: #fff;
    text-decoration: none;
    border-color: var(--brand-orange-bright);
  }

  .footer__section-arrow {
    color: var(--brand-orange-bright);
  }

  .footer__group-title {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand-orange-bright);
    margin-block-end: var(--space-sm);
  }

  .footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem var(--space-lg);
    font-size: var(--step--1);
  }

  .footer__news-body {
    max-width: 46ch;
    margin-block-end: var(--space-sm);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .footer__bottom {
    margin-block-start: var(--space-2xl);
    padding-block-start: var(--space-lg);
    border-block-start: 1px solid var(--border-inverse);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-xl);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .footer__complaints {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .footer__privacy {
    margin-inline-start: auto;
  }
</style>
