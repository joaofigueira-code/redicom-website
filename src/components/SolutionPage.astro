---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Hero from '@components/Hero.astro';
import Card from '@components/Card.astro';
import LeadForm from '@components/LeadForm.astro';
import CtaBand from '@components/CtaBand.astro';
import SolutionSection from '@components/SolutionSection.astro';
import SectionHeader from '@components/SectionHeader.astro';
import Comparison from '@components/Comparison.astro';

import type { SolutionCopy } from '@/data/copy/types';
import { site } from '@/data/site';
import { path, type Lang, type RouteId } from '@i18n/routes';
import { useTranslations } from '@i18n/utils';

/**
 * Modelo unico das paginas de solucao.
 *
 * Todas seguem a mesma ordem — promessa, provas concretas, detalhe, conversao —
 * para que a leitura seja previsivel e nenhuma pagina fique sem um ponto de
 * contacto natural. Em paginas longas o formulario aparece tambem a meio,
 * quando o leitor ja sabe o suficiente para querer falar connosco.
 */

interface Props {
  lang: Lang;
  routeId: RouteId;
  copy: SolutionCopy;
  parent?: { label: string; route: RouteId };
  relatedLabels?: Partial<Record<RouteId, string>>;
}

const { lang, routeId, copy, parent, relatedLabels = {} } = Astro.props;
const t = useTranslations(lang);

const crumbs = [
  ...(parent ? [{ label: parent.label, href: path(parent.route, lang) }] : []),
  { label: copy.breadcrumb },
];

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${site.product} — ${copy.breadcrumb}`,
  description: copy.meta.description,
  brand: { '@id': `${site.url}/#organization` },
  url: `${site.url}${path(routeId, lang)}`,
};

// Com formulario a meio, partimos as seccoes ao meio; sem ele, corre tudo
// seguido e a conversao fica so no bloco final.
const splitAt = copy.midForm ? Math.ceil(copy.sections.length / 2) : copy.sections.length;
const sectionsBefore = copy.sections.slice(0, splitAt);
const sectionsAfter = copy.sections.slice(splitAt);
---

<BaseLayout
  lang={lang}
  title={copy.meta.title}
  description={copy.meta.description}
  schema={productSchema}
>
  <Breadcrumbs lang={lang} items={crumbs} />

  <Hero
    eyebrow={copy.hero.eyebrow}
    title={copy.hero.title}
    lead={copy.hero.lead}
    primaryCta={{ label: copy.hero.primary, href: '#falar-connosco' }}
    compact
  />

  <section class="section section--tight features">
    <div class="container">
      <div class="grid grid--4">
        {
          copy.features.map((feature) => (
            <Card title={feature.title}>
              <p>{feature.body}</p>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  {
    sectionsBefore.map((section, index) => (
      <SolutionSection section={section} lang={lang} index={index} />
    ))
  }

  {
    copy.midForm && (
      <section class="section section--tight midform">
        <div class="container container--narrow">
          <LeadForm
            lang={lang}
            topic={routeId}
            variant="inline"
            heading={copy.midForm.heading}
            body={copy.midForm.body}
            submitLabel={copy.midForm.submit}
            id={`lead-${routeId}-mid`}
          />
        </div>
      </section>
    )
  }

  {
    sectionsAfter.map((section, index) => (
      <SolutionSection section={section} lang={lang} index={index + splitAt} />
    ))
  }

  {
    copy.comparison && (
      <section class="section comparison">
        <div class="container">
          <SectionHeader title={copy.comparison.title} lead={copy.comparison.lead} />
          <Comparison
            genericTitle={copy.comparison.genericTitle}
            redicomTitle={copy.comparison.redicomTitle}
            rows={copy.comparison.rows}
          />
        </div>
      </section>
    )
  }

  {
    copy.related && copy.related.length > 0 && (
      <section class="section section--tight related">
        <div class="container">
          <h2 class="related__title">{t('common.relatedPages')}</h2>
          <div class="grid grid--3">
            {copy.related
              .filter((related) => Boolean(relatedLabels[related]))
              .map((related) => (
                <Card
                  title={relatedLabels[related]!}
                  href={path(related, lang)}
                  ctaLabel={t('cta.more')}
                />
              ))}
          </div>
        </div>
      </section>
    )
  }

  <CtaBand
    lang={lang}
    topic={routeId}
    title={copy.closing.title}
    body={copy.closing.body}
    points={copy.closing.points}
    submitLabel={copy.closing.submit}
  />
</BaseLayout>

<style>
  .features {
    background: var(--surface-muted);
    border-block-end: 1px solid var(--border);
  }

  .midform {
    border-block: 1px solid var(--border);
  }

  .comparison {
    background: var(--surface-muted);
    border-block: 1px solid var(--border);
  }

  .related__title {
    font-size: var(--step-2);
    margin-block-end: var(--space-lg);
  }
</style>
