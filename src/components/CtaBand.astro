---
import LeadForm from '@components/LeadForm.astro';
import type { Lang } from '@i18n/routes';

/**
 * Bloco de conversao de fim de pagina.
 *
 * Emparelha um argumento curto com o formulario minimo, para que a decisao e
 * a accao fiquem no mesmo ecra — quem chega ao fim da pagina nao tem de
 * procurar por onde continuar.
 */

interface Props {
  lang: Lang;
  topic: string;
  title: string;
  body?: string;
  /** Pontos de reforco a esquerda do formulario. */
  points?: string[];
  submitLabel?: string;
  id?: string;
}

const { lang, topic, title, body, points = [], submitLabel, id } = Astro.props;
---

<section class="ctaband on-dark" id={id ?? 'falar-connosco'}>
  <div class="container ctaband__inner">
    <div class="ctaband__pitch">
      <h2 class="ctaband__title">{title}</h2>
      {body && <p class="ctaband__body">{body}</p>}

      {
        points.length > 0 && (
          <ul class="ctaband__points">
            {points.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
        )
      }
    </div>

    <div class="ctaband__form">
      <LeadForm
        lang={lang}
        topic={topic}
        variant="panel"
        submitLabel={submitLabel}
        id={`lead-${topic}`}
      />
    </div>
  </div>
</section>

<style>
  .ctaband {
    padding-block: var(--section-y);
  }

  .ctaband__inner {
    display: grid;
    gap: var(--space-2xl);
    align-items: start;
  }

  @media (min-width: 62rem) {
    .ctaband__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: var(--space-3xl);
    }
  }

  .ctaband__title {
    max-width: 18ch;
  }

  .ctaband__body {
    margin-block-start: var(--space-lg);
    max-width: 46ch;
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--text-body);
  }

  .ctaband__points {
    margin-block-start: var(--space-xl);
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-sm);
  }

  .ctaband__points li {
    position: relative;
    padding-inline-start: 1.6rem;
    color: var(--text-body);
  }

  .ctaband__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--brand-orange);
  }

  /* Dentro da banda escura o painel do formulario passa a vidro sobre navy. */
  .ctaband__form :global(.leadform--panel .leadform__inner) {
    background: rgba(255, 255, 255, 0.04);
    border-color: var(--border-inverse);
  }

  .ctaband__form :global(.field__input) {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.24);
    color: #fff;
  }

  .ctaband__form :global(.field__input::placeholder) {
    color: rgba(255, 255, 255, 0.45);
  }

  .ctaband__form :global(.field__input:hover) {
    border-color: rgba(255, 255, 255, 0.45);
  }
</style>
