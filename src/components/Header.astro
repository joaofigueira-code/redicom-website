---
import Logo from '@components/Logo.astro';
import { mainNav, utilityNav, resolveLink } from '@/data/navigation';
import { alternatePath, LANGUAGES, LANGUAGE_NAMES, path, type Lang } from '@i18n/routes';
import { useTranslations } from '@i18n/utils';

interface Props {
  lang: Lang;
  transparent?: boolean;
}

const { lang, transparent = false } = Astro.props;
const t = useTranslations(lang);
const currentPath = Astro.url.pathname;

/** Marca o item de menu correspondente a seccao que esta a ser vista. */
function isCurrentSection(routeId: string): boolean {
  const base = path(routeId as never, lang);
  return currentPath === base || currentPath.startsWith(base);
}
---

<header class:list={['header', transparent && 'header--transparent']} data-header>
  <div class="header__bar">
    <div class="header__container container container--wide">
      <Logo lang={lang} />

      <nav class="header__nav" aria-label={t('nav.main')}>
        <ul class="header__list">
          {
            mainNav.map((item) => {
              const href = path(item.route, lang);
              const current = isCurrentSection(item.route);
              return (
                <li class="header__item">
                  {item.groups ? (
                    <>
                      {/* Botao dividido: o nome vai direto a pagina-mae, a seta
                          abre o painel. Quem ja sabe o que quer nao passa pelo
                          menu; quem nao sabe, abre-o. */}
                      <span class="header__split" data-current={current ? 'true' : undefined}>
                        <a
                          class="header__link header__link--split"
                          href={href}
                          aria-current={current ? 'page' : undefined}
                        >
                          {item.label[lang]}
                        </a>
                        <button
                          class="header__disclosure"
                          aria-expanded="false"
                          aria-controls={`panel-${item.id}`}
                          aria-label={`${t('nav.open')}: ${item.label[lang]}`}
                          data-panel-toggle={item.id}
                        >
                          <span class="header__chevron" aria-hidden="true" />
                        </button>
                      </span>

                      <div class="header__panel" id={`panel-${item.id}`} data-panel={item.id} hidden>
                        <div class="header__panel-inner container container--wide">
                          {item.featured && (
                            <a class="header__featured" href={path(item.featured.route, lang)}>
                              <span class="header__featured-text">
                                <span class="header__featured-title">
                                  {item.featured.title[lang]}
                                </span>
                                <span class="header__featured-body">{item.featured.body[lang]}</span>
                              </span>
                              <span class="header__featured-cta">
                                {item.featured.cta[lang]}
                                <span aria-hidden="true">→</span>
                              </span>
                            </a>
                          )}

                          <div
                            class:list={[
                              'header__groups',
                              item.groups.length === 1 && 'header__groups--single',
                            ]}
                          >
                            {item.groups.map((group) => (
                              <div class="header__group">
                                <p class="header__group-title">{group.title[lang]}</p>
                                <ul class="header__group-list">
                                  {group.links.map((link) => {
                                    const resolved = resolveLink(link, lang);
                                    return (
                                      <li>
                                        <a class="header__card" href={resolved.href}>
                                          <span class="header__card-title">
                                            {resolved.label}
                                            {resolved.badge && (
                                              <span class="header__badge">{resolved.badge}</span>
                                            )}
                                          </span>
                                          {resolved.description && (
                                            <span class="header__card-body">
                                              {resolved.description}
                                            </span>
                                          )}
                                        </a>
                                      </li>
                                    );
                                  })}
                                </ul>
                              </div>
                            ))}
                          </div>

                          {item.extras && (
                            <ul class="header__extras">
                              {item.extras.map((link) => {
                                const resolved = resolveLink(link, lang);
                                return (
                                  <li>
                                    <a class="header__extra" href={resolved.href}>
                                      <span class="header__extra-title">
                                        {resolved.label}
                                        <span aria-hidden="true">→</span>
                                      </span>
                                      {resolved.description && (
                                        <span class="header__extra-body">
                                          {resolved.description}
                                        </span>
                                      )}
                                    </a>
                                  </li>
                                );
                              })}
                            </ul>
                          )}
                        </div>
                      </div>
                    </>
                  ) : (
                    <a
                      class="header__link"
                      href={href}
                      aria-current={current ? 'page' : undefined}
                    >
                      {item.label[lang]}
                    </a>
                  )}
                </li>
              );
            })
          }
        </ul>
      </nav>

      <div class="header__end">
        <!-- Interruptor de idioma: os dois idiomas sempre visiveis, o atual
             marcado. Um unico "EN" nao diz se e o idioma atual ou o destino. -->
        <div class="langswitch" role="group" aria-label={t('common.language')}>
          {
            LANGUAGES.map((code) =>
              code === lang ? (
                <span class="langswitch__option is-current" aria-current="true">
                  <span class="visually-hidden">{LANGUAGE_NAMES[code]}</span>
                  <span aria-hidden="true">{code.toUpperCase()}</span>
                </span>
              ) : (
                <a
                  class="langswitch__option"
                  href={alternatePath(currentPath, lang, code)}
                  hreflang={code}
                  lang={code}
                >
                  <span class="visually-hidden">{LANGUAGE_NAMES[code]}</span>
                  <span aria-hidden="true">{code.toUpperCase()}</span>
                </a>
              ),
            )
          }
        </div>

        <a class="header__cta" href={path('contact', lang)}>{t('cta.proposal')}</a>

        <button class="header__burger" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu">
          <span class="visually-hidden" data-label-open>{t('nav.open')}</span>
          <span class="header__burger-lines" aria-hidden="true"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Menu movel: uma lista simples, sem paineis sobrepostos. As ligacoes
       transversais (Integracoes, Documentacao) aparecem uma unica vez no
       fim, e nao repetidas dentro de cada seccao. -->
  <div class="header__mobile" id="mobile-menu" hidden>
    <div class="header__mobile-inner container">
      <nav aria-label={t('nav.main')}>
        {
          mainNav.map((item) => (
            <div class="mobile-section">
              <a class="mobile-section__head" href={path(item.route, lang)}>
                {item.label[lang]}
              </a>
              {item.groups && (
                <ul class="mobile-section__list">
                  {item.groups
                    .flatMap((group) => group.links)
                    .map((link) => {
                      const resolved = resolveLink(link, lang);
                      return (
                        <li>
                          <a href={resolved.href}>{resolved.label}</a>
                        </li>
                      );
                    })}
                </ul>
              )}
            </div>
          ))
        }

        <div class="mobile-section">
          <ul class="mobile-section__list">
            {
              utilityNav.map((link) => {
                const resolved = resolveLink(link, lang);
                return (
                  <li>
                    <a href={resolved.href}>{resolved.label}</a>
                  </li>
                );
              })
            }
          </ul>
        </div>
      </nav>

      <a class="header__cta header__cta--mobile" href={path('contact', lang)}>
        {t('cta.proposal')}
      </a>

      <div class="langswitch langswitch--mobile" role="group" aria-label={t('common.language')}>
        {
          LANGUAGES.map((code) =>
            code === lang ? (
              <span class="langswitch__option is-current" aria-current="true">
                {LANGUAGE_NAMES[code]}
              </span>
            ) : (
              <a
                class="langswitch__option"
                href={alternatePath(currentPath, lang, code)}
                hreflang={code}
                lang={code}
              >
                {LANGUAGE_NAMES[code]}
              </a>
            ),
          )
        }
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector('[data-header]');
  if (header) {
    // --- Sombra ao sair do topo ---------------------------------------
    const onScroll = () => {
      header.classList.toggle('is-stuck', window.scrollY > 8);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // --- Paineis do menu de escritorio --------------------------------
    const toggles = header.querySelectorAll('[data-panel-toggle]');
    const panels = header.querySelectorAll('[data-panel]');

    function closePanels(except) {
      toggles.forEach((toggle) => {
        if (toggle.dataset.panelToggle === except) return;
        toggle.setAttribute('aria-expanded', 'false');
      });
      panels.forEach((panel) => {
        if (panel.dataset.panel === except) return;
        panel.hidden = true;
      });
      header.classList.toggle('has-open-panel', Boolean(except));
    }

    toggles.forEach((toggle) => {
      const id = toggle.dataset.panelToggle;
      const panel = header.querySelector(`[data-panel="${id}"]`);
      if (!panel) return;

      toggle.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        closePanels(open ? undefined : id);
        toggle.setAttribute('aria-expanded', String(!open));
        panel.hidden = open;
      });
    });

    header.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closePanels();
        if (document.activeElement) document.activeElement.blur();
      }
    });

    document.addEventListener('click', (event) => {
      if (!header.contains(event.target)) closePanels();
    });

    // --- Menu movel ----------------------------------------------------
    const burger = header.querySelector('[data-menu-toggle]');
    const mobile = header.querySelector('#mobile-menu');

    if (burger) {
      burger.addEventListener('click', () => {
        const open = burger.getAttribute('aria-expanded') === 'true';
        burger.setAttribute('aria-expanded', String(!open));
        if (mobile) mobile.hidden = open;
        document.body.style.overflow = open ? '' : 'hidden';
        closePanels();
      });
    }
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--surface);
    border-block-end: 1px solid transparent;
    transition:
      border-color var(--duration) var(--ease),
      box-shadow var(--duration) var(--ease);
  }

  .header.is-stuck {
    border-block-end-color: var(--border);
    box-shadow: var(--shadow-sm);
  }

  /* A barra nao e texto corrido: usa a largura do ecra em vez de ficar
     presa a largura de leitura. E por isso que o logotipo encosta a
     esquerda e sobra espaco para o menu respirar ao centro. */
  .header__container {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: var(--header-height);
  }

  .header__nav {
    display: none;
    min-width: 0;
  }

  .header__list {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.6rem;
    background: none;
    border: 0;
    border-radius: var(--radius-sm);
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
    color: var(--text-heading);
    text-decoration: none;
    white-space: nowrap;
  }

  .header__link:hover {
    background: var(--surface-muted);
    color: var(--text-heading);
  }

  .header__link[aria-current] {
    color: var(--text-accent);
  }

  /* --- Botao dividido ------------------------------------------------ */
  .header__split {
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-sm);
    transition: background-color var(--duration) var(--ease);
  }

  .header__split:hover {
    background: var(--surface-muted);
  }

  /* O fundo e do conjunto, nao de cada metade: de outro modo o rato
     acende meio botao e o outro meio fica branco. */
  .header__split .header__link:hover {
    background: none;
  }

  .header__link--split {
    padding-inline-end: 0.25rem;
  }

  .header__split[data-current] .header__link {
    color: var(--text-accent);
  }

  .header__disclosure {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.6rem;
    height: 2rem;
    padding: 0;
    background: none;
    border: 0;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    cursor: pointer;
  }

  .header__disclosure:hover {
    color: var(--text-heading);
  }

  .header__chevron {
    width: 0.4rem;
    height: 0.4rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform var(--duration) var(--ease);
  }

  .header__disclosure[aria-expanded='true'] {
    color: var(--text-accent);
  }

  .header__disclosure[aria-expanded='true'] .header__chevron {
    transform: translateY(1px) rotate(225deg);
  }

  /* --- Painel do mega-menu ------------------------------------------ */
  .header__panel {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    background: var(--surface);
    border-block: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
  }

  .header__panel-inner {
    display: grid;
    gap: var(--space-lg);
    padding-block: var(--space-lg) var(--space-xl);
  }

  .header__groups {
    display: grid;
    gap: var(--space-lg);
    align-content: start;
  }

  @media (min-width: 48rem) {
    .header__groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-2xl);
    }

    /* Um unico grupo nao justifica uma coluna estreita com espaco vazio
       ao lado: a lista e que passa a ter colunas. */
    .header__groups--single {
      grid-template-columns: minmax(0, 1fr);
    }

    .header__groups--single .header__group-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.15rem var(--space-lg);
    }
  }

  @media (min-width: 72rem) {
    .header__groups--single .header__group-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .header__group-title {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-block-end: var(--space-sm);
  }

  .header__group-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.15rem;
  }

  .header__card {
    display: block;
    padding: 0.55rem 0.7rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: background-color var(--duration) var(--ease);
  }

  .header__card:hover {
    background: var(--surface-muted);
  }

  .header__card-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    color: var(--text-heading);
  }

  .header__badge {
    font-size: 0.68rem;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-orange-ink);
    background: rgba(239, 150, 0, 0.14);
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-pill);
  }

  .header__card-body {
    display: block;
    margin-block-start: 0.15rem;
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--text-muted);
  }

  /* --- Integracoes e Documentacao ------------------------------------ */
  /* Atravessam as tres seccoes e nao pertencem a nenhuma. Sao cartoes com
     moldura, e nao letra pequena no rodape do painel, porque sao duas das
     primeiras perguntas de quem esta a avaliar: liga-se ao que ja tenho,
     e posso ver como funciona antes de falar com alguem. */
  .header__extras {
    display: grid;
    gap: var(--space-sm);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 48rem) {
    .header__extras {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .header__extra {
    display: block;
    height: 100%;
    padding: 0.75rem 0.95rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-muted);
    text-decoration: none;
    transition:
      border-color var(--duration) var(--ease),
      background-color var(--duration) var(--ease);
  }

  .header__extra:hover {
    border-color: var(--brand-orange);
    background: var(--surface);
  }

  .header__extra-title {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    color: var(--text-heading);
  }

  .header__extra:hover .header__extra-title {
    color: var(--text-accent);
  }

  .header__extra-body {
    display: block;
    margin-block-start: 0.1rem;
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--text-muted);
  }

  /* --- Cartao de destaque -------------------------------------------- */
  /* Em cima e a toda a largura: e a frase que enquadra tudo o que vem a
     seguir, e nao uma coluna lateral que se le por ultimo. */
  .header__featured {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md) var(--space-xl);
    padding: var(--space-md) var(--space-lg);
    border-radius: var(--radius-lg);
    background: var(--brand-navy);
    color: #fff;
    text-decoration: none;
  }

  .header__featured-text {
    display: block;
    max-width: 62ch;
  }

  .header__featured-title {
    display: block;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: var(--weight-extrabold);
    line-height: 1.2;
  }

  .header__featured-body {
    display: block;
    margin-block-start: 0.2rem;
    font-size: var(--step--1);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.75);
  }

  .header__featured-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex: 0 0 auto;
    padding: 0.45rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: var(--radius-pill);
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
    color: var(--brand-orange-bright);
    white-space: nowrap;
  }

  .header__featured:hover .header__featured-cta {
    border-color: var(--brand-orange-bright);
  }

  /* --- Fim da barra -------------------------------------------------- */
  /* O fim da barra tambem nao encolhe: o que cede espaco e o menu. */
  .header__end {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-inline-start: auto;
  }

  /* --- Interruptor de idioma ----------------------------------------- */
  .langswitch {
    display: inline-flex;
    align-items: center;
    padding: 2px;
    background: var(--surface-muted);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
  }

  .langswitch__option {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.1rem;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.04em;
    color: var(--text-muted);
    text-decoration: none;
    transition:
      background-color var(--duration) var(--ease),
      color var(--duration) var(--ease);
  }

  .langswitch__option.is-current {
    background: var(--surface);
    color: var(--text-heading);
    box-shadow: var(--shadow-sm);
  }

  a.langswitch__option:hover {
    color: var(--text-heading);
  }

  .langswitch--mobile .langswitch__option {
    min-width: 0;
    padding: 0.5rem 1rem;
    font-size: var(--step--1);
  }

  .header__cta {
    display: none;
    padding: 0.6rem 1.25rem;
    background: var(--action);
    color: var(--action-text);
    border-radius: var(--radius-pill);
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    white-space: nowrap;
  }

  .header__cta:hover {
    background: var(--action-hover);
    color: var(--action-text);
  }

  /* --- Botao do menu movel ------------------------------------------- */
  .header__burger {
    width: 2.6rem;
    height: 2.6rem;
    display: grid;
    place-items: center;
    background: none;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .header__burger-lines,
  .header__burger-lines::before,
  .header__burger-lines::after {
    display: block;
    width: 1.15rem;
    height: 2px;
    background: var(--text-heading);
    border-radius: 2px;
    transition: transform var(--duration) var(--ease);
  }

  .header__burger-lines {
    position: relative;
  }

  .header__burger-lines::before,
  .header__burger-lines::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .header__burger-lines::before {
    top: -6px;
  }

  .header__burger-lines::after {
    top: 6px;
  }

  .header__burger[aria-expanded='true'] .header__burger-lines {
    background: transparent;
  }

  .header__burger[aria-expanded='true'] .header__burger-lines::before {
    transform: translateY(6px) rotate(45deg);
  }

  .header__burger[aria-expanded='true'] .header__burger-lines::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* --- Painel movel --------------------------------------------------- */
  .header__mobile {
    position: fixed;
    inset: var(--header-height) 0 0;
    background: var(--surface);
    overflow-y: auto;
    overscroll-behavior: contain;
    border-block-start: 1px solid var(--border);
  }

  .header__mobile-inner {
    padding-block: var(--space-lg) var(--space-3xl);
    display: grid;
    gap: var(--space-lg);
    justify-items: start;
  }

  .header__mobile-inner nav {
    width: 100%;
  }

  .mobile-section + .mobile-section {
    margin-block-start: var(--space-md);
    padding-block-start: var(--space-md);
    border-block-start: 1px solid var(--border);
  }

  .mobile-section__head {
    display: block;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: var(--weight-extrabold);
    color: var(--text-heading);
    text-decoration: none;
  }

  .mobile-section__list {
    list-style: none;
