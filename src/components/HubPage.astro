---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Hero from '@components/Hero.astro';
import SectionHeader from '@components/SectionHeader.astro';
import Card from '@components/Card.astro';
import Comparison from '@components/Comparison.astro';
import LeadForm from '@components/LeadForm.astro';
import CtaBand from '@components/CtaBand.astro';
import SolutionSection from '@components/SolutionSection.astro';

import type { HubCopy, HubId } from '@/data/copy/hubs';
import { site } from '@/data/site';
import { solutionLabels } from '@/data/copy';
import { path, type Lang, type RouteId } from '@i18n/routes';
import { useTranslations } from '@i18n/utils';

/**
 * Modelo das paginas-mae (Plataforma e Fashion Retail).
 *
 * A ordem responde a uma pergunta de cada vez: o que e isto (hero), porque e
 * que e diferente (pilares), o que inclui (modulos), quero falar (formulario),
 * como funciona ao detalhe (seccoes) e porque nao uma generica (comparacao).
 */

interface Props {
  lang: Lang;
  routeId: HubId;
  copy: HubCopy;
  secondaryRoute: RouteId;
}

const { lang, routeId, copy, secondaryRoute } = Astro.props;
const t = useTranslations(lang);
const labels = solutionLabels(lang);

// Os Servicos sao um servico prestado sobre a plataforma, nao a plataforma:
// o tipo de dados estruturados tem de o dizer.
const isService = routeId === 'services';

// Cinco modulos numa grelha de quatro deixavam um cartao sozinho na segunda
// linha. A grelha acompanha o numero de cartoes.
const moduleGrid = copy.modules.items.length % 4 === 0 ? 'grid--4' : 'grid--3';

const schema = {
  '@context': 'https://schema.org',
  '@type': isService ? 'Service' : 'SoftwareApplication',
  name: routeId === 'fashion' ? `${site.product}: Fashion Retail` : isService ? copy.meta.title : site.product,
  ...(isService
    ? { serviceType: 'Digital marketing automation' }
    : { applicationCategory: 'BusinessApplication', operatingSystem: 'Web' }),
  url: `${site.url}${path(routeId, lang)}`,
  provider: { '@id': `${site.url}/#organization` },
  description: copy.meta.description,
};
---

<BaseLayout
  lang={lang}
  title={copy.meta.title}
  description={copy.meta.description}
  schema={schema}
>
  <Breadcrumbs lang={lang} items={[{ label: copy.breadcrumb }]} />

  <Hero
    eyebrow={copy.hero.eyebrow}
    title={copy.hero.title}
    lead={copy.hero.lead}
    primaryCta={{ label: copy.hero.primary, href: '#falar-connosco' }}
    secondaryCta={{ label: copy.hero.secondary, href: path(secondaryRoute, lang) }}
  />

  <section class="section pillars">
    <div class="container">
      <SectionHeader
        eyebrow={copy.pillars.eyebrow}
        title={copy.pillars.title}
        lead={copy.pillars.lead}
      />
      <div class="grid grid--4">
        {
          copy.pillars.items.map((item) => (
            <Card title={item.title}>
              <p>{item.body}</p>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section modules on-dark">
    <div class="container">
      <SectionHeader
        eyebrow={copy.modules.eyebrow}
        title={copy.modules.title}
        lead={copy.modules.lead}
      />
      <div class:list={[`grid`, moduleGrid]}>
        {
          copy.modules.items.map((item) => (
            <Card
              title={item.title}
              href={path(item.route, lang)}
              ctaLabel={t('cta.more')}
            >
              <p>{item.body}</p>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  {
    copy.more && (
      <section class="section section--tight more">
        <div class="container">
          <h2 class="more__title">{copy.more.title}</h2>
          {copy.more.lead && <p class="more__lead">{copy.more.lead}</p>}
          <ul class="more__list">
            {copy.more.routes.map((route) => (
              <li>
                <a href={path(route, lang)}>{labels[route] ?? route}</a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section section--tight midform">
    <div class="container container--reading">
      <LeadForm
        lang={lang}
        topic={routeId}
        variant="inline"
        heading={copy.midForm.heading}
        body={copy.midForm.body}
        submitLabel={copy.midForm.submit}
        id={`lead-${routeId}-mid`}
      />
    </div>
  </section>

  {copy.sections.map((section, index) => <SolutionSection section={section} lang={lang} index={index} />)}

  {
    copy.comparison && (
      <section class="section comparison">
        <div class="container">
          <SectionHeader title={copy.comparison.title} lead={copy.comparison.lead} />
          <Comparison
            genericTitle={copy.comparison.genericTitle}
            redicomTitle={copy.comparison.redicomTitle}
            rows={copy.comparison.rows}
          />
        </div>
      </section>
    )
  }

  <CtaBand
    lang={lang}
    topic={routeId}
    title={copy.closing.title}
    body={copy.closing.body}
    points={copy.closing.points}
    submitLabel={copy.closing.submit}
  />
</BaseLayout>

<style>
  .pillars {
    background: var(--surface-muted);
    border-block-end: 1px solid var(--border);
  }

  /* Dentro do bloco escuro os cartoes assentam em vidro, nao em branco. */
  .modules :global(.card) {
    background: rgba(255, 255, 255, 0.04);
    border-color: var(--border-inverse);
  }

  .modules :global(.card--link:hover) {
    background: rgba(255, 255, 255, 0.07);
    border-color: var(--brand-orange);
  }

  .more {
    border-block-end: 1px solid var(--border);
  }

  .more__title {
    font-size: var(--step-2);
    margin-block-end: var(--space-xs);
  }

  .more__lead {
    margin-block-end: var(--space-lg);
    max-width: 62ch;
  }

  /* Lista de etiquetas, nao de linhas: sao onze temas secundarios e em
     ecra estreito uma linha por tema ocupava mais do que a pagina toda. */
  .more__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .more__list a {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    font-size: var(--step--1);
    line-height: 1.3;
    color: var(--text-strong);
    text-decoration: none;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--surface);
    transition:
      border-color var(--duration) var(--ease),
      color var(--duration) var(--ease);
  }

  .more__list a:hover {
    color: var(--text-accent);
    border-color: var(--brand-orange);
  }

  .midform {
    border-block-end: 1px solid var(--border);
  }

  .comparison {
    background: var(--surface-muted);
    border-block-start: 1px solid var(--border);
  }
</style>
