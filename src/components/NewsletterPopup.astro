---
import NewsletterForm from '@components/NewsletterForm.astro';
import { useTranslations } from '@i18n/utils';
import type { Lang } from '@i18n/routes';

/**
 * Janela de subscricao, so na pagina inicial.
 *
 * Quando aparece: quando a pessoa chega ao segundo bloco da pagina (a faixa
 * dos numeros, "desde 2002"), assinalado com data-news-trigger. Nao ha
 * contador de tempo: o gatilho e a leitura, nao o relogio, e assim nunca
 * aparece a alguem que ainda esta a ler o topo.
 *
 * Quando nao aparece: se ja subscreveu ou ja dispensou neste browser, ou se
 * a pessoa preferir menos movimento (prefers-reduced-motion nao cobre isto,
 * mas a marca no localStorage cobre).
 *
 * Nao e possivel reconhecer a maquina: nenhum browser da acesso ao endereco
 * MAC. A marca fica no localStorage do proprio browser.
 */

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="pop" data-newsletter-popup hidden>
  <div class="pop__backdrop" data-pop-close></div>

  <div class="pop__panel" role="dialog" aria-modal="true" aria-labelledby="pop-title">
    <button class="pop__close" type="button" data-pop-close aria-label={t('news.close')}>
      <span aria-hidden="true">×</span>
    </button>

    <p class="pop__eyebrow">{t('news.title')}</p>
    <h2 class="pop__title" id="pop-title">{t('news.popupTitle')}</h2>
    <p class="pop__body">{t('news.popupBody')}</p>

    <NewsletterForm lang={lang} variant="stacked" id="newsletter-popup" />

    <button class="pop__dismiss" type="button" data-pop-close>{t('news.dismiss')}</button>
  </div>
</div>

<style>
  .pop {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: end center;
    padding: var(--space-md);
  }

  @media (min-width: 40rem) {
    .pop {
      place-items: center;
    }
  }

  .pop__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(1, 26, 45, 0.45);
  }

  .pop__panel {
    position: relative;
    width: min(28rem, 100%);
    padding: var(--space-xl);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .pop__close {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    background: none;
    border: 0;
    border-radius: var(--radius-pill);
    font-size: 1.4rem;
    line-height: 1;
    color: var(--text-muted);
    cursor: pointer;
  }

  .pop__close:hover {
    background: var(--surface-muted);
    color: var(--text-heading);
  }

  .pop__eyebrow {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-accent);
  }

  .pop__title {
    margin-block: var(--space-xs) var(--space-sm);
    font-size: var(--step-2);
  }

  .pop__body {
    margin-block-end: var(--space-lg);
    font-size: var(--step--1);
    color: var(--text-body);
  }

  .pop__dismiss {
    margin-block-start: var(--space-md);
    background: none;
    border: 0;
    padding: 0;
    font-family: var(--font-display);
    font-size: var(--step--1);
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  .pop__dismiss:hover {
    color: var(--text-heading);
  }
</style>

<script>
  import { hasNewsletterMark, setNewsletterMark } from '@/lib/leads';

  const popup = document.querySelector<HTMLElement>('[data-newsletter-popup]');
  const trigger = document.querySelector('[data-news-trigger]');

  if (popup && trigger && !hasNewsletterMark()) {
    let shown = false;

    // Uma coisa de cada vez: enquanto a barra de consentimento estiver a
    // espera de resposta, a janela nao aparece por cima dela.
    function barPending() {
      return document.documentElement.hasAttribute('data-consent-open');
    }

    let waitingForConsent = false;

    function open() {
      if (shown) return;
      if (barPending()) {
        waitingForConsent = true;
        return;
      }
      shown = true;
      observer.disconnect();
      popup!.hidden = false;
      popup!.querySelector<HTMLInputElement>('input[name="email"]')?.focus();
    }

    function close() {
      popup!.hidden = true;
      // Dispensar conta como resposta: nao voltamos a insistir neste browser.
      setNewsletterMark();
    }

    // Metade do bloco a vista e ja houve scroll: sem a segunda condicao, um
    // ecra alto abria a janela sem a pessoa ter feito nada.
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting && window.scrollY > 0) open();
        }
      },
      { threshold: 0.5 },
    );

    observer.observe(trigger);

    popup.querySelectorAll('[data-pop-close]').forEach((node) => {
      node.addEventListener('click', close);
    });

    document.addEventListener('redicom:consent', () => {
      if (waitingForConsent) open();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !popup.hidden) close();
    });

    // Se subscrever pelo rodape antes de chegar aqui, a janela nao aparece.
    document.addEventListener('redicom:subscribed', () => {
      shown = true;
      observer.disconnect();
      popup.hidden = true;
    });
  }
</script>
