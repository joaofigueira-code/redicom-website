---
import { site } from '@/data/site';

/**
 * Redes sociais, em icone.
 *
 * So aparecem as redes que tem endereco definido em site.ts. O Reddit esta
 * por criar: o icone ja esta desenhado e a entrada ja existe, so falta o
 * endereco — mal a conta exista, aparece sozinho, aqui e nos dados
 * estruturados da organizacao.
 */

interface Props {
  /** Dimensao do icone em pixeis. */
  size?: number;
}

const { size = 20 } = Astro.props;

const networks = [
  { id: 'linkedin', label: 'LinkedIn', href: site.social.linkedin },
  { id: 'instagram', label: 'Instagram', href: site.social.instagram },
  { id: 'facebook', label: 'Facebook', href: site.social.facebook },
  { id: 'reddit', label: 'Reddit', href: site.social.reddit },
].filter((network) => Boolean(network.href));
---

<ul class="social">
  {
    networks.map((network) => (
      <li>
        <a
          class="social__link"
          href={network.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={network.label}
          title={network.label}
        >
          {network.id === 'linkedin' && (
            <svg
              width={size}
              height={size}
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zm1.78 13.02H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" />
            </svg>
          )}

          {network.id === 'instagram' && (
            <svg
              width={size}
              height={size}
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <rect x="2" y="2" width="20" height="20" rx="5.5" />
              <circle cx="12" cy="12" r="4.2" />
              <circle cx="17.6" cy="6.4" r="1.1" fill="currentColor" stroke="none" />
            </svg>
          )}

          {network.id === 'facebook' && (
            <svg
              width={size}
              height={size}
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M24 12.07C24 5.44 18.63.07 12 .07S0 5.44 0 12.07c0 5.99 4.39 10.95 10.13 11.85v-8.38H7.08v-3.47h3.05V9.43c0-3.01 1.79-4.67 4.53-4.67 1.31 0 2.69.24 2.69.24v2.95h-1.51c-1.49 0-1.96.93-1.96 1.88v2.25h3.33l-.53 3.47h-2.8v8.38C19.61 23.02 24 18.06 24 12.07z" />
            </svg>
          )}

          {network.id === 'reddit' && (
            <svg
              width={size}
              height={size}
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              aria-hidden="true"
              focusable="false"
            >
              <ellipse cx="12" cy="14" rx="9" ry="6.4" />
              <circle cx="21" cy="4.6" r="1.7" fill="currentColor" stroke="none" />
              <path d="M12 7.6 13.9 3l5.6 1.2" />
              <circle cx="8.9" cy="13.4" r="1.3" fill="currentColor" stroke="none" />
              <circle cx="15.1" cy="13.4" r="1.3" fill="currentColor" stroke="none" />
              <path d="M8.9 16.9a5 5 0 0 0 6.2 0" />
            </svg>
          )}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .social .social__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid var(--border-inverse, rgba(255, 255, 255, 0.16));
    border-radius: var(--radius-pill);
    color: inherit;
    transition:
      border-color var(--duration) var(--ease),
      color var(--duration) var(--ease),
      background-color var(--duration) var(--ease);
  }

  .social .social__link:hover {
    color: var(--brand-orange-bright);
    border-color: var(--brand-orange-bright);
    background: rgba(255, 255, 255, 0.05);
    text-decoration: none;
  }

  .social .social__link svg {
    display: block;
  }
</style>
