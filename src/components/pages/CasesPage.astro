---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Hero from '@components/Hero.astro';
import CtaBand from '@components/CtaBand.astro';

import { caseStudies, casesIndexCopy, caseDraftNotice } from '@/data/cases';
import { site } from '@/data/site';
import { casePath, path, type Lang } from '@i18n/routes';

/**
 * Indice dos casos de sucesso.
 *
 * O filtro e por familia de setor e nao por setor: os setores do site atual
 * sao dezasseis e um filtro com dezasseis botoes nao se usa. A etiqueta fina
 * continua no cartao, que e onde interessa.
 *
 * O filtro e progressivo: sem JavaScript aparecem todos os casos, que e o
 * comportamento correto. Os casos por escrever ficam visiveis para a equipa
 * os poder rever, mas assinalados.
 */

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = casesIndexCopy[lang];

const entries = caseStudies.map((study) => ({
  slug: study.slug,
  status: study.status,
  image: study.image,
  href: casePath(study.slug, lang),
  ...study[lang],
}));

const families = [...new Set(entries.map((entry) => entry.family))].sort((a, b) =>
  a.localeCompare(b, lang),
);
const drafts = entries.filter((entry) => entry.status === 'draft').length;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: copy.meta.title,
  description: copy.meta.description,
  url: `${site.url}${path('cases', lang)}`,
  publisher: { '@id': `${site.url}/#organization` },
};
---

<BaseLayout
  lang={lang}
  title={copy.meta.title}
  description={copy.meta.description}
  schema={schema}
>
  <Breadcrumbs lang={lang} items={[{ label: copy.breadcrumb }]} />

  <Hero
    eyebrow={copy.hero.eyebrow}
    title={copy.hero.title}
    lead={copy.hero.lead}
    primaryCta={{ label: copy.hero.primary, href: '#falar-connosco' }}
    compact
  />

  <section class="section cases">
    <div class="container">
      {
        families.length > 1 && (
          <div class="filters" data-filters>
            <span class="filters__label" id="filters-label">
              {copy.filterLabel}
            </span>
            <div class="filters__row" role="group" aria-labelledby="filters-label">
              <button type="button" class="chip" data-family="all" aria-pressed="true">
                {copy.allLabel}
              </button>
              {families.map((family) => (
                <button type="button" class="chip" data-family={family} aria-pressed="false">
                  {family}
                </button>
              ))}
            </div>
          </div>
        )
      }

      <div class="grid grid--3 cases__grid">
        {
          entries.map((entry) => (
            <article class="case" data-family={entry.family}>
              {/* Espaco reservado ate haver imagem do projeto. Mostra o nome
                  do cliente para o cartao continuar a ser identificavel. */}
              <a class="case__thumb" href={entry.href} tabindex="-1" aria-hidden="true">
                {entry.image ? (
                  <img src={entry.image} alt="" loading="lazy" />
                ) : (
                  <span class="case__thumb-name">{entry.client}</span>
                )}
              </a>

              <div class="case__body">
                <div class="case__head">
                  <span class="case__sector">{entry.sector}</span>
                  {entry.status === 'draft' && <span class="case__draft">draft</span>}
                </div>

                <h2 class="case__client">{entry.client}</h2>
                <p class="case__headline">{entry.headline}</p>
                <p class="case__summary">{entry.summary}</p>

                {entry.results && entry.results.length > 0 && (
                  <ul class="case__results">
                    {entry.results.slice(0, 2).map((result) => (
                      <li>
                        <strong>{result.value}</strong>
                        <span>{result.label}</span>
                      </li>
                    ))}
                  </ul>
                )}

                <a class="case__link" href={entry.href}>
                  {copy.readLabel}
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          ))
        }
      </div>

      <p class="cases__empty" data-empty hidden>{copy.empty}</p>

      {
        drafts > 0 && (
          <p class="cases__notice">
            {caseDraftNotice[lang]}
          </p>
        )
      }
    </div>

    <script>
      /**
       * Filtro por familia de setor. So corre se houver botoes — sem ele, a
       * lista fica completa, que e o estado correto por omissao.
       */
      const filters = document.querySelector('[data-filters]');

      if (filters) {
        const chips = filters.querySelectorAll<HTMLButtonElement>('.chip');
        const cards = document.querySelectorAll<HTMLElement>('.case');
        const empty = document.querySelector<HTMLElement>('[data-empty]');

        filters.addEventListener('click', (event) => {
          const chip = (event.target as HTMLElement).closest<HTMLButtonElement>('.chip');
          if (!chip) return;

          const family = chip.dataset.family;
          chips.forEach((item) => item.setAttribute('aria-pressed', String(item === chip)));

          let visible = 0;
          cards.forEach((card) => {
            const match = family === 'all' || card.dataset.family === family;
            card.hidden = !match;
            if (match) visible += 1;
          });

          if (empty) empty.hidden = visible > 0;
        });
      }
    </script>
  </section>

  <CtaBand
    lang={lang}
    topic="cases"
    title={copy.closing.title}
    body={copy.closing.body}
    points={copy.closing.points}
    submitLabel={copy.closing.submit}
  />
</BaseLayout>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-md);
    margin-block-end: var(--space-xl);
  }

  .filters__label {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
    color: var(--text-muted);
  }

  .filters__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .chip {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--text-strong);
    cursor: pointer;
  }

  .chip:hover {
    border-color: var(--text-strong);
  }

  .chip[aria-pressed='true'] {
    background: var(--brand-navy);
    border-color: var(--brand-navy);
    color: #fff;
  }

  .case {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    overflow: hidden;
  }

  .case[hidden] {
    display: none;
  }

  /* Espaco reservado da imagem: proporcao fixa para os cartoes nao saltarem
     quando as imagens reais entrarem. */
  .case__thumb {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    background: var(--brand-navy);
    background-image: linear-gradient(
      135deg,
      var(--brand-navy) 0%,
      var(--surface-inverse-soft) 100%
    );
    text-decoration: none;
  }

  .case__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .case__thumb-name {
    padding-inline: var(--space-md);
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.02em;
    text-align: center;
    color: rgba(255, 255, 255, 0.62);
  }

  .case__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    flex: 1;
    padding: var(--space-lg);
  }

  .case__head {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .case__sector {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-accent);
  }

  .case__draft {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
    background: var(--brand-orange);
    color: var(--action-text);
  }

  .case__client {
    font-size: var(--step-1);
  }

  .case__headline {
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    color: var(--text-strong);
  }

  .case__summary {
    font-size: var(--step--1);
  }

  .case__results {
    list-style: none;
    margin: var(--space-xs) 0 0;
    padding: var(--space-md) 0 0;
    border-block-start: 1px solid var(--border);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md);
  }

  .case__results li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .case__results strong {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: var(--weight-extrabold);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--text-heading);
  }

  .case__results span {
    font-size: var(--step--1);
    color: var(--text-muted);
    line-height: 1.3;
  }

  .case__link {
    margin-block-start: auto;
    padding-block-start: var(--space-sm);
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    font-size: var(--step--1);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }

  .case__link:hover {
    text-decoration: underline;
  }

  .cases__empty {
    margin-block-start: var(--space-xl);
    color: var(--text-muted);
  }

  .cases__notice {
    margin-block-start: var(--space-2xl);
    padding: var(--space-md) var(--space-lg);
    border-inline-start: 3px solid var(--brand-orange);
    background: var(--surface-muted);
    font-size: var(--step--1);
    max-width: 72ch;
  }
</style>
