---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Stats from '@components/Stats.astro';
import Card from '@components/Card.astro';
import CtaBand from '@components/CtaBand.astro';

import { caseDraftNotice, caseMissingCopy, defaultClosing, type CaseStudy } from '@/data/cases';
import { solutionLabels } from '@/data/copy';
import { site } from '@/data/site';
import { casePath, path, type Lang } from '@i18n/routes';
import { useTranslations } from '@i18n/utils';

/**
 * Pagina de um caso de sucesso.
 *
 * A ordem e a de uma historia: com quem estamos a falar, o que estava a
 * correr mal, o que fizemos, o que mudou. Os numeros aparecem cedo, logo a
 * seguir ao cabecalho, porque sao a razao pela qual alguem abre a pagina.
 *
 * Nem todos os casos tem historia escrita. Os que ainda so tem o resumo do
 * site atual mostram a mesma estrutura, um aviso e a lista do que falta — e
 * melhor mostra-los assim a equipa do que escondidos.
 */

interface Props {
  lang: Lang;
  study: CaseStudy;
}

const { lang, study } = Astro.props;
const copy = study[lang];
const t = useTranslations(lang);
const isDraft = study.status === 'draft';
const missing = caseMissingCopy[lang];
const closing = copy.closing ?? defaultClosing[lang];
const hasStory = Boolean(copy.challenge || copy.solution || copy.outcome);

const labels = solutionLabels(lang);
const modules = study.modules.filter((route) => Boolean(labels[route]));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${copy.client}, ${copy.headline}`,
  description: copy.meta.description,
  url: `${site.url}${casePath(study.slug, lang)}`,
  publisher: { '@id': `${site.url}/#organization` },
  about: { '@id': `${site.url}/#organization` },
};
---

<BaseLayout
  lang={lang}
  title={copy.meta.title}
  description={copy.meta.description}
  noindex={isDraft}
  schema={schema}
>
  <Breadcrumbs
    lang={lang}
    items={[
      { label: lang === 'pt' ? 'Casos de Sucesso' : 'Success Stories', href: path('cases', lang) },
      { label: copy.client },
    ]}
  />

  <header class="casehero">
    <div class="container casehero__inner">
      <div class="casehero__text">
        <p class="casehero__sector">{copy.sector}</p>
        <h1 class="casehero__client">{copy.client}</h1>
        <p class="casehero__headline">{copy.headline}</p>
        {copy.lead && <p class="casehero__lead">{copy.lead}</p>}
      </div>

      {/* Espaco reservado ate haver imagem do projeto. */}
      <div class="casehero__media">
        {
          study.image ? (
            <img src={study.image} alt={copy.client} />
          ) : (
            <span class="casehero__placeholder">
              {lang === 'pt' ? 'Imagem do projeto por adicionar' : 'Project image to be added'}
            </span>
          )
        }
      </div>
    </div>
  </header>

  {
    isDraft && (
      <div class="container">
        <p class="draftnote">{caseDraftNotice[lang]}</p>
      </div>
    )
  }

  {
    copy.results && copy.results.length > 0 && (
      <section class="section section--tight results">
        <div class="container">
          <Stats stats={copy.results} />
        </div>
      </section>
    )
  }

  {
    copy.challenge && (
      <section class="section story story--muted">
        <div class="container container--reading">
          <p class="eyebrow">{lang === 'pt' ? 'O desafio' : 'The challenge'}</p>
          <h2 class="story__title">{copy.challenge.title}</h2>
          {copy.challenge.paragraphs.map((paragraph) => <p class="story__p">{paragraph}</p>)}
        </div>
      </section>
    )
  }

  {
    copy.solution && (
      <section class="section story">
        <div class="container">
          <div class="container--reading story__head">
            <p class="eyebrow">{lang === 'pt' ? 'A solução' : 'The solution'}</p>
            <h2 class="story__title">{copy.solution.title}</h2>
            {copy.solution.paragraphs.map((paragraph) => <p class="story__p">{paragraph}</p>)}
          </div>

          {copy.solution.cards && copy.solution.cards.length > 0 && (
            <div class="grid grid--3 story__cards">
              {copy.solution.cards.map((card) => (
                <Card title={card.title}>
                  <p>{card.body}</p>
                </Card>
              ))}
            </div>
          )}
        </div>
      </section>
    )
  }

  {
    copy.outcome && (
      <section class="section story story--muted">
        <div class="container container--reading">
          <p class="eyebrow">{lang === 'pt' ? 'Resultados' : 'Results'}</p>
          <h2 class="story__title">{copy.outcome.title}</h2>
          {copy.outcome.paragraphs.map((paragraph) => <p class="story__p">{paragraph}</p>)}
        </div>
      </section>
    )
  }

  {
    copy.quote && (
      <section class="section section--tight">
        <div class="container container--reading">
          <figure class="quote">
            <blockquote class="quote__text">{copy.quote.text}</blockquote>
            <figcaption class="quote__by">
              <span class="quote__author">{copy.quote.author}</span>
              <span class="quote__role">{copy.quote.role}</span>
            </figcaption>
          </figure>
        </div>
      </section>
    )
  }

  {
    !hasStory && (
      <section class="section missing">
        <div class="container container--reading">
          <h2 class="missing__title">{missing.title}</h2>
          <p class="missing__body">{missing.body}</p>
          <ul class="missing__list">
            {missing.fields.map((field) => (
              <li>{field}</li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    modules.length > 0 && (
      <section class="section section--tight modules">
        <div class="container">
          <h2 class="modules__title">
            {lang === 'pt' ? 'O que foi usado neste projeto' : 'What this project runs on'}
          </h2>
          <div class="grid grid--3">
            {modules.map((route) => (
              <Card title={labels[route]!} href={path(route, lang)} ctaLabel={t('cta.more')} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CtaBand
    lang={lang}
    topic={`case-${study.slug}`}
    title={closing.title}
    body={closing.body}
    submitLabel={closing.submit}
  />
</BaseLayout>

<style>
  .casehero {
    background: var(--surface-muted);
    border-block-end: 1px solid var(--border);
    padding-block: var(--section-y);
  }

  .casehero__inner {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  @media (min-width: 56rem) {
    .casehero__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-3xl);
    }
  }

  .casehero__sector {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-accent);
  }

  .casehero__client {
    margin-block-start: var(--space-xs);
    font-size: var(--step-5);
  }

  .casehero__headline {
    margin-block-start: var(--space-sm);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: var(--weight-semibold);
    color: var(--text-strong);
  }

  .casehero__lead {
    margin-block-start: var(--space-md);
    max-width: 52ch;
  }

  .casehero__media {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-lg);
    background-image: linear-gradient(
      135deg,
      var(--brand-navy) 0%,
      var(--surface-inverse-soft) 100%
    );
    overflow: hidden;
  }

  .casehero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .casehero__placeholder {
    padding-inline: var(--space-lg);
    text-align: center;
    font-family: var(--font-display);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }

  .draftnote {
    margin-block-start: var(--space-lg);
    padding: var(--space-md) var(--space-lg);
    border-inline-start: 3px solid var(--brand-orange);
    background: var(--surface-muted);
    font-size: var(--step--1);
    max-width: 72ch;
  }

  .results {
    border-block-end: 1px solid var(--border);
  }

  .story--muted {
    background: var(--surface-muted);
    border-block: 1px solid var(--border);
  }

  .story__title {
    margin-block: var(--space-xs) var(--space-lg);
    font-size: var(--step-3);
  }

  .story__p + .story__p {
    margin-block-start: var(--space-md);
  }

  .story__cards {
    margin-block-start: var(--space-2xl);
  }

  .quote {
    margin: 0;
    border-inline-start: 3px solid var(--brand-orange);
    padding-inline-start: var(--space-lg);
  }

  .quote__text {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: var(--leading-snug);
    color: var(--text-heading);
  }

  .quote__by {
    margin-block-start: var(--space-md);
    display: flex;
    flex-direction: column;
    font-size: var(--step--1);
  }

  .quote__author {
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    color: var(--text-strong);
  }

  .quote__role {
    color: var(--text-muted);
  }

  .missing {
    border-block-start: 1px solid var(--border);
  }

  .missing__title {
    font-size: var(--step-2);
  }

  .missing__body {
    margin-block: var(--space-sm) var(--space-md);
  }

  .missing__list {
    margin: 0;
    padding-inline-start: 1.2rem;
    display: grid;
    gap: var(--space-xs);
    font-size: var(--step--1);
  }

  .modules {
    background: var(--surface-muted);
    border-block-start: 1px solid var(--border);
  }

  .modules__title {
    font-size: var(--step-2);
    margin-block-end: var(--space-lg);
  }
</style>
