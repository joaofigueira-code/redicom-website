---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'start' | 'center';
  as?: 'h2' | 'h3';
}

const { eyebrow, title, lead, align = 'start', as: Tag = 'h2' } = Astro.props;
---

<header class:list={['sheader', align === 'center' && 'sheader--center']}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Tag class="sheader__title">{title}</Tag>
  {lead && <p class="sheader__lead">{lead}</p>}
</header>

<style>
  .sheader {
    max-width: 48rem;
    margin-block-end: var(--space-2xl);
  }

  .sheader--center {
    margin-inline: auto;
    text-align: center;
  }

  .sheader__title {
    margin-block-start: var(--space-sm);
    max-width: 24ch;
  }

  .sheader--center .sheader__title {
    margin-inline: auto;
  }

  .sheader__lead {
    margin-block-start: var(--space-md);
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--text-body);
  }
</style>
