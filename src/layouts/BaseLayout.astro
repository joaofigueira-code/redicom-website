---
import '@fontsource-variable/inter';
import '@fontsource/open-sans/400.css';
import '@fontsource/open-sans/700.css';
import '@/styles/global.css';

import Seo from '@components/Seo.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import BackToTop from '@components/BackToTop.astro';
import ConsentBar from '@components/ConsentBar.astro';

import { LANGUAGE_TAGS, type Lang } from '@i18n/routes';
import { useTranslations } from '@i18n/utils';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Cabecalho transparente sobre um hero escuro. */
  transparentHeader?: boolean;
}

const {
  lang,
  title,
  description,
  image,
  noindex,
  schema,
  transparentHeader = false,
} = Astro.props;

const t = useTranslations(lang);
---

<!doctype html>
<html lang={LANGUAGE_TAGS[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="mask-icon" href="/favicon.svg?v=2" color="#EF9600" />
    <meta name="theme-color" content="#011a2d" />

    <Seo
      lang={lang}
      title={title}
      description={description}
      image={image}
      noindex={noindex}
      schema={schema}
    />

    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#main">{t('nav.skip')}</a>

    <Header lang={lang} transparent={transparentHeader} />

    <main id="main">
      <slot />
    </main>

    <Footer lang={lang} />
    <BackToTop lang={lang} />
    <ConsentBar lang={lang} />
  </body>
</html>
